# TEMPLATE ONLY — never put real keys in this file.
# This is the shareable/committable file. Real secrets go in .env (gitignored).
#
# Setup:  copy .env.example .env    then edit .env
# Get free paper-trading keys at https://alpaca.markets

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper trading is the default. Only set to false deliberately, after paper validation.
ALPACA_PAPER=true

# Decision backend:
#   scheduled (time-of-day routing) | orb | meanrev | rule | claude | ollama
DECIDER_BACKEND=scheduled

# Strategies to run in parallel WITHOUT trading them, each with its own
# virtual book. Free head-to-head comparison on identical data.
SHADOW_BACKENDS=rule,orb,meanrev

# OBSERVE MODE: run every strategy, place ZERO orders. Costs nothing, risks
# nothing, still produces full comparison data. Use this to find a strategy
# with positive expectancy before committing capital.
OBSERVE_MODE=true

# Cost charged to each virtual fill, per side. Without it shadows trade at the
# midpoint and look better than any real fill could.
# SHADOW_SLIPPAGE_BPS=2.0

# STRATEGY_SCHEDULE=09:30-11:00=orb,11:00-14:30=meanrev,14:30-15:40=rule
# OLLAMA_MODEL=gemma4:latest

# Anthropic key — only needed when DECIDER_BACKEND=claude
# ANTHROPIC_API_KEY=

# SEC Form 4 insider feed (public data, no key needed).
# SEC requires real contact info in the User-Agent on every request.
# SEC_USER_AGENT=claude-daytrader research your@email.com
# INSIDER_ENABLED=true
# INSIDER_LOOKBACK_DAYS=90
# INSIDER_CACHE_MINUTES=60

# Optional overrides
# WATCHLIST=SPY,QQQ,NVDA,TSLA,AAPL
# CYCLE_SECONDS=300
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high
